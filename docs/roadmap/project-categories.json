    {"id": "edit", "label": "Trim clips and edit framing and captions", "owner": "WP14", "capability": "cap.content.versions", "optional": false},
    {"id": "review", "label": "Review picture, captions, audio and rights", "owner": "WP24", "capability": "cap.media.video", "optional": false},
    {"id": "export", "label": "Save reviewed clips and the editable project locally", "owner": "WP24", "capability": "cap.media.video", "optional": false},
    {"id": "publish", "label": "Review a connected account and approve a post", "owner": "WP28", "capability": "cap.publishing.publish", "optional": true}
  ],
  "replicaStages": [
    {"id": "reference", "label": "Record permitted references and their use limits", "owner": "WP10", "capability": "cap.evidence.import", "optional": false},
    {"id": "brief", "label": "Describe the behavior and functional requirements", "owner": "WP11", "capability": "cap.brief.capture", "optional": false},
    {"id": "design", "label": "Create and revise an original design", "owner": "WP14", "capability": "cap.content.versions", "optional": false},
    {"id": "export", "label": "Export the reviewed specification for local handoff", "owner": "WP17", "capability": "cap.library.export", "optional": false},
    {"id": "prototype", "label": "Build a small sandboxed prototype with local fixtures", "owner": "WP41", "capability": "cap.interactive.build", "optional": true}
  ],
  "dayTraderStages": [
    {"id": "practice-data", "label": "Choose built-in practice bars or import an authorized local historical dataset", "owner": "WP41", "capability": "cap.trading.replay", "optional": false},
    {"id": "rules", "label": "Save versioned practice rules and simulation settings", "owner": "WP14", "capability": "cap.content.versions", "optional": false},
    {"id": "replay", "label": "Replay bars offline and record simulated decisions", "owner": "WP41", "capability": "cap.trading.replay", "optional": false},
    {"id": "journal", "label": "Review the decision journal with its dataset and rule revisions", "owner": "WP14", "capability": "cap.content.versions", "optional": false},
    {"id": "export", "label": "Export the reviewed practice journal locally", "owner": "WP17", "capability": "cap.library.export", "optional": false}
  ],
  "designBuilderPolicy": {
    "clipper": {
      "editAuthority": "studio-project-variant",
      "executorsPerAction": 1,
      "executionBindings": ["host", "qualified-route", "selected-model-if-used", "approved-inputs-and-destination", "bounded-cost"],
      "proposalBindings": ["source-revision", "variant-revision"],
      "apply": "reviewed-undoable-edit",
      "supoclip": "documented-workflow-reference",
      "clipsKitty": "optional-unqualified-external-engine"
    },
    "replica": {
      "references": "permitted-material",
      "design": "original",
      "prototype": "small-local-sandbox",
      "network": "disabled",
      "publication": "outside-builder"
    },
    "day-trader": {
      "purpose": "local-practice-only",
      "replay": "deterministic-offline",
      "network": "disabled",
      "liveOrders": "disabled",
      "financialTransactions": "disabled"
    }
  },
  "stackEntries": {
    "scene-editor": {"label": "Edit scenes by hand", "kind": "built-in", "cost": "local", "capability": "cap.content.versions"},
    "storyboard-skill": {"label": "Guided storyboard skill", "kind": "skill", "cost": "selected-model", "capability": "cap.harness.definitions"},
    "hyperframes": {"label": "HyperFrames local renderer", "kind": "local-tool", "cost": "local", "capability": "cap.media.video"},
    "capture-import": {"label": "Import approved screenshots or a screen recording", "kind": "built-in", "cost": "local", "capability": "cap.media.library"},
    "blender": {"label": "Render a local Blender shot", "kind": "local-tool", "cost": "local", "capability": "cap.media.video"},
    "shot-import": {"label": "Import an existing 3D shot", "kind": "built-in", "cost": "local", "capability": "cap.media.library"},
    "voice-import": {"label": "Use a recorded narration", "kind": "built-in", "cost": "local", "capability": "cap.media.library"},
    "elevenlabs": {"label": "Generate narration through ElevenLabs", "kind": "connector", "cost": "quote-required", "capability": "cap.media.video"},
    "earshot-mcp": {"label": "Suggest and check sound cues through Earshot MCP", "kind": "mcp", "cost": "local", "capability": "cap.tools.broker"},
    "effect-plugin": {"label": "Add an optional third-party visual effect", "kind": "plugin", "cost": "route-specific", "capability": "cap.connections.plugins"},
    "openverse": {"label": "Find images and audio through Openverse", "kind": "connector", "cost": "route-specific", "capability": "cap.evidence.research"}
  },
  "styles": {
    "kinetic-type": {
      "version": 1,
      "label": "Kinetic typography",
      "required": [
        {"need": "Script and timed text", "chooseOne": ["scene-editor", "storyboard-skill"]},
        {"need": "Final render", "chooseOne": ["hyperframes"]}
      ],
      "optional": ["voice-import", "elevenlabs", "earshot-mcp", "effect-plugin"]
    },
    "product-demo": {
      "version": 1,
      "label": "Product walkthrough",
      "required": [
        {"need": "Demo footage", "chooseOne": ["capture-import"]},
        {"need": "Shot sequence", "chooseOne": ["scene-editor", "storyboard-skill"]},
        {"need": "Final render", "chooseOne": ["hyperframes"]}
      ],
      "optional": ["voice-import", "elevenlabs", "earshot-mcp"]
    },
    "3d-showcase": {
      "version": 1,
      "label": "3D showcase",
      "required": [
        {"need": "3D shot", "chooseOne": ["blender", "shot-import"]},
        {"need": "Shot sequence", "chooseOne": ["scene-editor", "storyboard-skill"]},
        {"need": "Final render", "chooseOne": ["hyperframes"]}
      ],
      "optional": ["voice-import", "elevenlabs", "openverse", "effect-plugin"]
    },
    "stick-figure-explainer": {
      "version": 1,
      "label": "Stick-figure explainer",
      "required": [
        {"need": "Poses, props and scene timing", "chooseOne": ["scene-editor", "storyboard-skill"]},
        {"need": "Final render", "chooseOne": ["hyperframes"]}
      ],
      "optional": ["voice-import", "elevenlabs"]
    }
  },
  "styleRecipes": {
    "status": "design-only",
    "policy": {
      "selection": "save-recipe-and-prepare-checklist",
      "skipStyle": "use-manual-default-without-reference",
      "qualification": "exact-tool-build-and-selected-host",
      "referenceUse": "derive-style-traits-from-permitted-material",
      "referenceRetention": "project-scoped",
      "install": "explicit-approval",
      "acquisition": "explicit-approval-for-authorized-source",
      "upload": "explicit-approval-for-specific-data-and-destination"
    },
    "tools": {
      "manual-scene-editor": {"label": "Edit scenes and timed text by hand", "role": "edit", "kind": "built-in", "scope": "local", "capability": "cap.content.versions"},
      "manual-clip-editor": {"label": "Trim, reframe and caption by hand", "role": "edit", "kind": "built-in", "scope": "local", "capability": "cap.content.versions"},
      "ffprobe": {"label": "Inspect local media with ffprobe", "role": "inspect", "kind": "local-tool", "scope": "local", "capability": "cap.media.library"},
      "ffmpeg": {"label": "Encode a local clip with FFmpeg", "role": "render", "kind": "local-tool", "scope": "local", "capability": "cap.media.video"},
      "hyperframes": {"label": "Compose and render locally with HyperFrames", "role": "render", "kind": "local-tool", "scope": "local", "capability": "cap.media.video"},
      "remotion": {"label": "Compose and render locally with Remotion", "role": "render", "kind": "local-tool", "scope": "local", "capability": "cap.media.video"},
      "whisper-cpp": {"label": "Transcribe selected audio locally with whisper.cpp", "role": "transcribe", "kind": "local-tool", "scope": "local", "capability": "cap.evidence.transcribe"},
      "yt-dlp": {"label": "Acquire an authorized source with yt-dlp", "role": "acquire", "kind": "local-tool", "scope": "authorized-download", "capability": "cap.media.library"}
    },
    "builders": {
      "video": {
        "styleAt": "style",
        "prepareAt": ["prepare"],
        "origins": ["manual", "built-in-example", "supplied-reference"],
        "defaultPreset": "timed-text",
        "presets": {
          "timed-text": {
            "version": 1,
            "label": "Timed text explainer",
            "treatment": {"framing": "canvas", "captions": "timed-text", "graphics": "text-motion"},
            "aspectRatio": "16:9",
            "required": {"edit": ["manual-scene-editor"], "render": ["hyperframes", "remotion"]},
            "optional": ["whisper-cpp", "yt-dlp"]
          },
          "demo-walkthrough": {
            "version": 1,
            "label": "Screen walkthrough with callouts",
            "treatment": {"framing": "screen", "captions": "editable", "graphics": "callouts"},
            "aspectRatio": "16:9",
            "required": {"edit": ["manual-scene-editor"], "render": ["hyperframes", "remotion"]},
            "optional": ["ffprobe", "whisper-cpp"]
          },
          "stick-figure-explainer": {
            "version": 1,
            "label": "Stick-figure explainer",
            "treatment": {"framing": "canvas", "captions": "editable", "graphics": "stick-figures"},
            "aspectRatio": "16:9",
            "required": {"edit": ["manual-scene-editor"], "render": ["hyperframes", "remotion"]},
            "optional": ["whisper-cpp"]
          }
        }
      },
      "clipper": {
        "styleAt": "edit",
        "prepareAt": ["source", "edit"],
        "origins": ["manual", "built-in-example", "supplied-reference"],
        "defaultPreset": "manual-portrait",
        "presets": {
          "manual-portrait": {
            "version": 1,
            "label": "Portrait cut with editable captions",
            "treatment": {"framing": "manual-subject", "captions": "editable", "graphics": "none"},
            "aspectRatio": "9:16",
            "required": {"inspect": ["ffprobe"], "edit": ["manual-clip-editor"], "render": ["ffmpeg"]},
            "optional": ["whisper-cpp", "yt-dlp"]
          },
          "designed-portrait": {
            "version": 1,
            "label": "Portrait cut with graphic callouts",
            "treatment": {"framing": "manual-subject", "captions": "editable", "graphics": "callouts"},
            "aspectRatio": "9:16",
            "required": {"inspect": ["ffprobe"], "edit": ["manual-clip-editor"], "render": ["hyperframes", "remotion"]},
            "optional": ["whisper-cpp", "yt-dlp"]
          }
        }
      }
    }
  }
}
