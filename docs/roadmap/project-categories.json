    {"id": "brief", "label": "Choose an idea, audience and goal", "owner": "WP11", "capability": "cap.brief.capture", "optional": false},
    {"id": "storyboard", "label": "Write the script and plan scenes", "owner": "WP14", "capability": "cap.content.versions", "optional": false},
    {"id": "assets", "label": "Choose visuals, sound and narration", "owner": "WP17", "capability": "cap.media.library", "optional": false},
    {"id": "render", "label": "Preview scenes and render a cut", "owner": "WP24", "capability": "cap.media.video", "optional": false},
    {"id": "review", "label": "Review picture, captions, audio and rights", "owner": "WP24", "capability": "cap.media.video", "optional": false},
    {"id": "export", "label": "Save the reviewed video and editable project", "owner": "WP24", "capability": "cap.media.video", "optional": false},
    {"id": "publish", "label": "Review a connected account and approve a post", "owner": "WP28", "capability": "cap.publishing.publish", "optional": true}
